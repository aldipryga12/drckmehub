{
  "manifest_version": 3,
  "name": "Elite Toolz \u2014 ChatGPT Access",
  "version": "3.0.0",
  "description": "Admin-managed cookie import with user login.",
  "permissions": [
    "cookies",
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://*.chatgpt.com/*",
    "https://gpt.elitetoolz.store/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Elite Access",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png"
    }
  },
  "background": {
    "service_worker": "worker.js"
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  }
}